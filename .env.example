# mytheus-intelligence — AI/inference tier. Copy to .env and fill for local dev.
# This tier NEVER writes Postgres directly; it consumes/produces events and calls the gRPC mesh.

# Event backbone (Redpanda + Schema Registry) — contracts come from mytheus-events.
REDPANDA_BROKERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# Redis (budget mirror, answer cache) — namespaced nexus:{org_id}:...
REDIS_URL=redis://localhost:6379/0

# Vector store (embedding-service is the only writer).
QDRANT_URL=http://localhost:6333

# gRPC mesh: identity-tenant-service.GetUserContext (org_id in metadata).
IDENTITY_GRPC_ADDR=localhost:50051

# LLM routing (LiteLLM). Provider keys land per-deployment; never commit real values.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Observability.
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
