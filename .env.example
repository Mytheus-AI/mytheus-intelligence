# mytheus-intelligence — AI/inference tier. Copy to .env and fill for local dev.
# This tier NEVER writes Postgres directly; it consumes/produces events and calls the gRPC mesh.

# Event backbone (Redpanda + Schema Registry) — contracts come from mytheus-events.
REDPANDA_BROKERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# Redis (budget mirror, answer cache) — namespaced nexus:{org_id}:...
REDIS_URL=redis://localhost:6379/0

# Vector store (embedding-service is the only writer).
QDRANT_URL=http://localhost:6333

# Object storage (ingestion-service only) — real MinIO, S3-API compatible. nexus-documents for
# direct /ingest uploads, nexus-attachments for calendar attachments (both {org_id}/-prefixed).
MINIO_ENDPOINT_URL=http://localhost:9002
MINIO_ACCESS_KEY=mytheus
MINIO_SECRET_KEY=mytheus-dev-secret

# This repo's own outbox/inbox Postgres history (Plan 5-6 task 7), schema `intelligence` in the
# SAME physical Postgres as mytheus-backend. mytheus_ai_app is the consumer/request-path role;
# mytheus_ai_relay drains intelligence.outbox only. BOOTSTRAP_DATABASE_URL runs migrations
# (schema owner; must be able to CREATE SCHEMA, which mytheus-backend's `postgres` role cannot
# on this Supabase image — see migrations/env.py). Never point DATABASE_URL at the bootstrap
# credential: mytheus_ai_app is the only role every tenant_isolation RLS policy is proven against.
DATABASE_URL=postgresql+asyncpg://mytheus_ai_app:mytheus_ai_app@localhost:5433/mytheus
RELAY_DATABASE_URL=postgresql+asyncpg://mytheus_ai_relay:mytheus_ai_relay@localhost:5433/mytheus
BOOTSTRAP_DATABASE_URL=postgresql+asyncpg://supabase_admin:postgres@localhost:5433/mytheus

# GPU toggle for embedding-service / reranker-service. 0 (default) runs BGE-small-en /
# BGE-reranker-base on CPU via sentence-transformers; 1 requests a GPU actor from Ray Serve
# (BLOCKED in this dev environment per Plan 5-6 tasks 7/8's scope note — no CUDA device here).
EMBEDDING_GPU=0
RERANKER_GPU=0

# gRPC mesh: identity-tenant-service.GetUserContext (org_id in metadata).
IDENTITY_GRPC_ADDR=localhost:50051

# LLM routing (LiteLLM). Provider keys land per-deployment; never commit real values.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Observability.
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
