# Postgres roles and URLs
DATABASE_URL=postgresql+asyncpg://mytheus_ai_app:mytheus_ai_app@localhost:5443/mytheus
RELAY_DATABASE_URL=postgresql+asyncpg://mytheus_ai_relay:mytheus_ai_relay@localhost:5443/mytheus
BOOTSTRAP_DATABASE_URL=postgresql+asyncpg://supabase_admin:postgres@localhost:5443/mytheus
AGE_DATABASE_URL=postgresql://nexus_graph:nexus-graph-dev@localhost:5434/nexus_graph

# Redis, Redpanda, Temporal
REDPANDA_BROKERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8085
REDIS_URL=redis://localhost:6390/0

# Service URLs, ports and internal secrets
GRPC_PORT=50103
IDENTITY_GRPC_ADDR=localhost:50051
# Ask Myte (rag-service): bff's MCP server, called as the asker. Compose default http://bff:8000.
BFF_URL=http://localhost:8000

# Object storage and recording
S3_ENDPOINT_URL=http://localhost:9002
S3_ACCESS_KEY_ID=mytheus
S3_SECRET_ACCESS_KEY=mytheus-dev-secret
S3_REGION=us-east-1

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=dev-qdrant-write
QDRANT_READ_ONLY_API_KEY=dev-qdrant-read

# Models and LLM
EMBEDDING_GPU=0
RERANKER_GPU=0
RERANKER_MIN_REPLICAS=1
RERANKER_MAX_REPLICAS=4
RERANKER_PRELOAD=1
EMBEDDING_PRELOAD=1
ANTHROPIC_API_KEY=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
